# Copy this file to .env and fill in your values.
# NEVER commit .env — it is gitignored.

ANTHROPIC_API_KEY=your_key_here

# Optional overrides
# LLM_MODEL=claude-sonnet-4-6
# MAX_TURNS=10
# API_URL=http://localhost:8000

# Langfuse tracing — optional. Leave blank to disable tracing.
# Free cloud account at https://langfuse.com — copy keys from Settings → API Keys.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
#
# IMPORTANT: LANGFUSE_HOST must match the region your account was created in,
# or traces POST to the wrong endpoint and silently never appear. Pick ONE:
# LANGFUSE_HOST=https://us.cloud.langfuse.com   # US region
# LANGFUSE_HOST=https://cloud.langfuse.com      # EU region (default if unset)
